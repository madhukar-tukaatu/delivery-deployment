      "title": "Laravel Backend Exceptions & Queue Failures",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 40 }
    },
    {
      "id": 9,
      "type": "logs",
      "title": "Backend App & Queue Worker Stack Traces",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 41 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "{container=~\"delivery.*(app|queue|scheduler|reverb).*\"} |~ \"(?i)error|exception|failed|critical\" |~ \"$search\"",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "options": {
        "showLabels": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      }
    }
  ],
