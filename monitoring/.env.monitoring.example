# Copy to .env.monitoring on the VPS (do NOT commit real secrets)
#   cp .env.monitoring.example .env.monitoring
#
# Required: set a strong Grafana password and the mysqld-exporter DB password.
# The exporter user is created with the SQL in DEPLOY-VPS.md (not the MySQL root user).

# Server timezone (dashboards and logs)
TZ=Asia/Kathmandu

# Docker network the APP stack is attached to.
# Find it with: docker network ls | grep delivery
# Then confirm app containers are on it:
#   docker inspect delivery-backend-app --format '{{range $k,$v := .NetworkSettings.Networks}}{{$k}}{{end}}'
# This MUST be marked external in compose — a typo would otherwise create an empty unused network.
DELIVERY_NETWORK=delivery-deployment_delivery

# Service hosts / container names on that network
REDIS_HOST=delivery-redis
REDIS_PORT=6379
# Leave empty if Redis has no password (the stock compose does not set one).
REDIS_PASSWORD=
NGINX_HOST=delivery-backend-nginx
MYSQL_HOST=delivery-mysql
PHP_FPM_HOST=delivery-backend-app

# Dedicated mysqld-exporter credentials (NOT the MySQL root user)
MYSQL_EXPORTER_USER=exporter
MYSQL_EXPORTER_PASSWORD=CHANGE_ME

# Optional Laravel Redis queue key pattern for redis-exporter (SCAN in db0).
# Default Laravel prefix is slug(APP_NAME) + "_database_". Adjust after checking:
#   docker exec delivery-redis redis-cli keys '*queues*'
REDIS_QUEUE_KEY_PATTERN=db0=*queues*

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
# Used behind an SSH tunnel or an OpenResty proxy on localhost. Do not publish :3001 on 0.0.0.0.
GRAFANA_ROOT_URL=http://127.0.0.1:3001

# Alertmanager placeholder (leave as-is until you have a webhook or email).
# Example: https://hooks.slack.com/services/CHANGE_ME
ALERTMANAGER_WEBHOOK_URL=
