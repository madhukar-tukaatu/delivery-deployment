# Copy to .env.monitoring on the VPS (do NOT commit real secrets)
#   cp .env.monitoring.example .env.monitoring

# Find with: docker network ls | grep delivery
DELIVERY_NETWORK=delivery-deployment_delivery

# Service hosts inside the Docker network
REDIS_HOST=delivery-redis
NGINX_HOST=delivery-backend-nginx

# Grafana Admin Credentials
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-strong-password
GRAFANA_ROOT_URL=http://127.0.0.1:3001
